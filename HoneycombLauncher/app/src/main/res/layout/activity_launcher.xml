<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/holo_background">

    <!-- Main stack: top bar + workspace + page dots -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <TextView
                android:id="@+id/search_box"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginRight="12dp"
                android:background="@drawable/search_box_background"
                android:drawableLeft="@android:drawable/ic_menu_search"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:text="@string/search_hint"
                android:textColor="@color/holo_text_secondary" />

            <ImageButton
                android:id="@+id/apps_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="8dp"
                android:background="@drawable/button_bg_holo"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="@string/all_apps" />

            <ImageButton
                android:id="@+id/add_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/button_bg_holo"
                android:src="@android:drawable/ic_menu_add"
                android:contentDescription="@string/add_to_home" />
        </LinearLayout>

        <com.lukeiscooldev.honeylauncher.Workspace
            android:id="@+id/workspace"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/page_indicator_height"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <!-- All apps overlay -->
    <FrameLayout
        android:id="@+id/all_apps_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/holo_all_apps_bg"
        android:visibility="gone">

        <GridView
            android:id="@+id/all_apps_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="auto_fit"
            android:columnWidth="@dimen/app_icon_cell_size"
            android:gravity="center"
            android:horizontalSpacing="8dp"
            android:verticalSpacing="16dp"
            android:padding="16dp"
            android:scrollbarStyle="outsideOverlay"
            android:clipToPadding="false" />
    </FrameLayout>

    <!-- Remove zone: slides down from the top during a drag -->
    <LinearLayout
        android:id="@+id/remove_zone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/remove_zone_height"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/remove_zone_background"
        android:alpha="0">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remove"
            android:textColor="@android:color/white"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
